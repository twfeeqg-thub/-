rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'email', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 128
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 64))
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 50000));
      allow update: if isOwner(userId) && isValidId(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'email', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 128
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 64))
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 50000));
      allow delete: if false;

      // App State Sync Documents
      match /app_state/{stateId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(stateId)
          && request.resource.data.keys().hasOnly(['uid', 'version', 'dataJson', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.version is string
          && request.resource.data.version.size() <= 16
          && request.resource.data.dataJson is string
          && request.resource.data.dataJson.size() <= 500000;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(stateId);
      }
    }
  }
}
