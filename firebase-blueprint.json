{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 64,
          "description": "Display name of the user"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 50000,
          "description": "Avatar image URL or preset identifier"
        },
        "email": {
          "type": "string",
          "maxLength": 128,
          "description": "User email address"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of profile update"
        }
      },
      "required": ["email", "updatedAt"]
    },
    "AppStateV2": {
      "title": "AppStateV2",
      "description": "Consolidated state document for trading settings, custom lines, trades, and preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "User ID owning this state"
        },
        "version": {
          "type": "string",
          "maxLength": 16,
          "description": "State schema version e.g. v2"
        },
        "dataJson": {
          "type": "string",
          "maxLength": 500000,
          "description": "Serialized JSON of synchronized user app state"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of synchronization"
        }
      },
      "required": ["uid", "version", "dataJson", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores individual user profile data"
    },
    "/users/{userId}/app_state/{stateId}": {
      "schema": "AppStateV2",
      "description": "Stores user v2 synced app state and trading configurations"
    }
  }
}
